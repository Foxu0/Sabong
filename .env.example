# Copy to .env (git-ignored) for local runs, or set these in the Render / Koyeb dashboard.
# Never commit real values.

# TiDB / MySQL (required for accounts, betting, leaderboard)
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=sabong_roosters_db

# Signs player session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECS=604800

# Comma-separated Google OAuth client IDs whose ID tokens /auth/google accepts.
# Leave empty to disable Google Sign-In.
GOOGLE_CLIENT_IDS=

# Email delivery for OTP codes (Resend first, SMTP fallback)
RESEND_API_KEY=
RESEND_FROM=Sabong Roosters <onboarding@resend.dev>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
